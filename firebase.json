{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "remoteconfig": {
    "template": "remoteconfig.template.json"
  },
  "hosting": [
    {
      "target": "legal",
      "public": "site",
      "cleanUrls": true,
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=300"
            }
          ]
        }
      ]
    },
    {
      "target": "demo",
      "public": "web/dist",
      "trailingSlash": true,
      "redirects": [
        {
          "source": "/",
          "destination": "/tu-duy/",
          "type": 302
        }
      ],
      "rewrites": [
        {
          "source": "/app/**",
          "destination": "/app/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=300"
            }
          ]
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  }
}
